; Engine configuration file.
config_version=5

[application]

config/name="Vintage Typewriter"
config/description="Full-screen iPad vintage typewriter with spring haptics, paper feed, and HQ settings."
config/version="1.2.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

TwSettings="*res://scripts/tw_settings.gd"

[audio]

driver/enable_input=true
buses/default_bus_layout=""

[display]

window/size/viewport_width=1180
window/size/viewport_height=820
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=5

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.12, 0.09, 0.07, 1)
textures/vram_compression/import_etc2_astc=true
