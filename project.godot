; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="AI Godot Studio"
config/description="Describe a game. Create builds Godot 4 + C++ GDExtension (with GDScript fallback), AI, and internet resources. Run to play."
config/version="2.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

AppSettings="*res://scripts/app_settings.gd"
StudioMemory="*res://scripts/studio_memory.gd"
AIOrchestrator="*res://scripts/ai/ai_orchestrator.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/min_viewport_width=960
window/size/min_viewport_height=640

[rendering]

environment/defaults/default_clear_color=Color(0.06, 0.08, 0.1, 1)
